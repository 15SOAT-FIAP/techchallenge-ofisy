diff --git a/.github/workflows/destroy-app.yml b/.github/workflows/destroy-app.yml
new file mode 100644
index 00000000..9b8752bf
--- /dev/null
+++ b/.github/workflows/destroy-app.yml
@@ -0,0 +1,35 @@
+name: Destruir Aplicação no Kubernetes (EKS)
+
+on:
+  workflow_dispatch:
+
+jobs:
+  destroy-app:
+    name: Remover Manifestos do Kubernetes
+    runs-on: ubuntu-latest
+    environment: AWS_ACADEMY
+
+    steps:
+      - name: Checkout do código
+        uses: actions/checkout@v4
+
+      - name: Configurar Credenciais AWS
+        uses: aws-actions/configure-aws-credentials@v4
+        with:
+          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
+          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+          aws-session-token: ${{ secrets.AWS_SESSION_TOKEN }}
+          aws-region: us-east-1
+
+      - name: Conectar ao EKS Cluster
+        run: |
+          aws eks update-kubeconfig --region us-east-1 --name ofisy-cluster
+
+      - name: Remover Recursos do EKS
+        run: |
+          kubectl delete -f k8s/hpa.yml --ignore-not-found
+          kubectl delete -f k8s/service.yml --ignore-not-found
+          kubectl delete -f k8s/deployment.yml --ignore-not-found
+          kubectl delete -f k8s/configmap.yml --ignore-not-found
+          kubectl delete -f k8s/secret.yml --ignore-not-found
+          echo "Aplicação desinstalada do Kubernetes com sucesso."
