        </mxCell>
        <mxCell id="c1151" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" value="Cria 1 ServiceOrderExecution (PENDING)&lt;br&gt;por serviço do orçamento&lt;br&gt;Soma os itens em total_price" vertex="1">
