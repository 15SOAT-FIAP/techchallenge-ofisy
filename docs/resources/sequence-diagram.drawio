        <mxCell id="c1147" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" value="Nota de infraestrutura: toda chamada HTTP_PROXY desta&lt;br&gt;API Gateway para a Ofisy API atravessa um VPC Link até&lt;br&gt;a NLB privada do EKS&amp;nbsp; a NLB não tem exposição pública&lt;br&gt;direta (ver techchallenge-ofisy-eks-infra). Válido para&lt;br&gt;todas as setas Gateway → Ofisy API deste diagrama;&lt;br&gt;omitido nas demais para não repetir." vertex="1">
          <mxGeometry height="116" width="280" x="752" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c1148" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" value="Valida senha com BCryptPasswordEncoder&lt;br&gt;Gera JWT HS256 (sub = email, exp = 24h)&lt;br&gt;Papel (ROLE_ADMIN | ATTENDANT | MECHANIC)&lt;br&gt;carregado via OfisyUserDetailsService" vertex="1">
          <mxGeometry height="88" width="280" x="1492" y="492" as="geometry" />
        </mxCell>
        <mxCell id="c1149" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" value="JwtAuthFilter valida o token&lt;br&gt;@PreAuthorize: role ADMIN ou ATTENDANT" vertex="1">
          <mxGeometry height="60" width="280" x="1492" y="808" as="geometry" />
        </mxCell>
        <mxCell id="c1150" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" value="O Mecânico autentica-se pelo mesmo fluxo&lt;br&gt;de login do Bloco A, recebendo um token&lt;br&gt;com a role MECHANIC" vertex="1">
