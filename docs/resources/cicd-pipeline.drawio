<mxfile host="app.diagrams.net" agent="Claude"><diagram id="cicd" name="CI/CD"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="CI/CD da Ofisy: integração em cada repositório e ambiente montado pelo ofisy-platform" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1700" height="34" as="geometry" /></mxCell><mxCell id="v2" value="O CI roda a cada push e pull request na master de cada repositório. O deploy não é disparado pelo CI: o AWS Academy expira a sessão a cada 4 h, então o &lt;i&gt;ofisy-platform&lt;/i&gt; recria o ambiente inteiro chamando os workflows de deploy de cada repositório (&lt;i&gt;workflow_call&lt;/i&gt;) na ordem das dependências." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1800" height="40" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;Dev&lt;/b&gt;&lt;br&gt;push / pull request" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B0B0B0;strokeColor=#8C8C8C;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="150" height="50" as="geometry" /></mxCell><mxCell id="v4" value="CI em cada repositório (GitHub Actions, push e PR na master)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="640" height="590" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;core, billing, stock, execution&lt;/b&gt;  &lt;i&gt;[Java 21 · &lt;i&gt;ci.yml&lt;/i&gt;]&lt;/i&gt;&lt;br&gt;mvn verify: testes unitários e de integração com Testcontainers (PostgreSQL e LocalStack), JaCoCo com mínimo de 80%; publica o JAR e o relatório de cobertura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="250" y="160" width="600" height="70" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="195" /></Array></mxGeometry></mxCell><mxCell id="v7" value="&lt;b&gt;ms-ofisy-notification&lt;/b&gt;  &lt;i&gt;[Java 21 · &lt;i&gt;ci.yml&lt;/i&gt;]&lt;/i&gt;&lt;br&gt;Sobe DynamoDB e SQS isolados, roda a suíte incluindo as integrações e falha se algum teste de integração for pulado; publica as evidências e o JAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="600" height="70" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v3" target="v7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="285" /></Array></mxGeometry></mxCell><mxCell id="v9" value="&lt;b&gt;techchallenge-ofisy-auth&lt;/b&gt;  &lt;i&gt;[Go · &lt;i&gt;ci.yml&lt;/i&gt;]&lt;/i&gt;&lt;br&gt;golangci-lint, gofmt, testes com cobertura mínima e Gosec (SARIF no GitHub Security)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="250" y="340" width="600" height="70" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v3" target="v9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="375" /></Array></mxGeometry></mxCell><mxCell id="v11" value="&lt;b&gt;techchallenge-ofisy-eks-infra&lt;/b&gt;  &lt;i&gt;[Terraform · &lt;i&gt;pr-plan*.yml&lt;/i&gt;]&lt;/i&gt;&lt;br&gt;terraform plan da rede e EKS, da mensageria, das Lambdas e do API Gateway em cada PR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="250" y="430" width="600" height="70" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v3" target="v11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="465" /></Array></mxGeometry></mxCell><mxCell id="v13" value="&lt;b&gt;techchallenge-ofisy-rds-infra&lt;/b&gt;  &lt;i&gt;[Terraform · &lt;i&gt;validate.yml&lt;/i&gt;]&lt;/i&gt;&lt;br&gt;fmt e validate dos módulos de banco" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="250" y="520" width="600" height="70" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v3" target="v13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="555" /></Array></mxGeometry></mxCell><mxCell id="v15" value="Todos os repositórios também têm o &lt;i&gt;notify-pr.yml&lt;/i&gt;, que avisa o time no Discord quando um PR é aberto." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="250" y="612" width="600" height="40" as="geometry" /></mxCell><mxCell id="v16" value="Subir ambiente: ofisy-platform/.github/workflows/up.yml (workflow_dispatch)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="980" height="760" as="geometry" /></mxCell><mxCell id="v17" value="&lt;b&gt;network (1)&lt;/b&gt;&lt;br&gt;eks-infra · deploy-network" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="160" width="200" height="54" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;messaging&lt;/b&gt;&lt;br&gt;eks-infra · deploy-messaging" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="270" width="200" height="54" as="geometry" /></mxCell><mxCell id="v19" value="&lt;b&gt;eks (2)&lt;/b&gt;&lt;br&gt;eks-infra · deploy-eks&lt;br&gt;5 clusters + Datadog (Helm)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="270" width="200" height="66" as="geometry" /></mxCell><mxCell id="v20" value="&lt;b&gt;auth-images (3)&lt;/b&gt;&lt;br&gt;auth · cd (imagens no ECR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="270" width="200" height="54" as="geometry" /></mxCell><mxCell id="v21" value="&lt;b&gt;databases (4)&lt;/b&gt;&lt;br&gt;rds-infra · deploy&lt;br&gt;4 RDS + DynamoDB" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="270" width="200" height="66" as="geometry" /></mxCell><mxCell id="v22" value="&lt;b&gt;auth-lambda (5)&lt;/b&gt;&lt;br&gt;eks-infra · deploy-auth-lambda" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1530" y="400" width="200" height="54" as="geometry" /></mxCell><mxCell id="v23" value="&lt;b&gt;app-core (6)&lt;/b&gt;&lt;br&gt;techchallenge-ofisy · cd" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="520" width="200" height="54" as="geometry" /></mxCell><mxCell id="v24" value="&lt;b&gt;app-execution (6)&lt;/b&gt;&lt;br&gt;ms-ofisy-execution · cd" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="520" width="200" height="54" as="geometry" /></mxCell><mxCell id="v25" value="&lt;b&gt;app-stock (6)&lt;/b&gt;&lt;br&gt;ms-ofisy-stock · cd" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="520" width="200" height="54" as="geometry" /></mxCell><mxCell id="v26" value="&lt;b&gt;app-notification (6)&lt;/b&gt;&lt;br&gt;ms-ofisy-notification · cd" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="630" width="200" height="54" as="geometry" /></mxCell><mxCell id="v27" value="&lt;b&gt;app-billing (6)&lt;/b&gt;&lt;br&gt;ms-ofisy-billing · cd" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="630" width="200" height="54" as="geometry" /></mxCell><mxCell id="v28" value="&lt;b&gt;api-gateway (7)&lt;/b&gt;&lt;br&gt;eks-infra · deploy-api-gateway" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1630" y="760" width="200" height="54" as="geometry" /></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v20" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v35" value="espera eks, databases e messaging" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1110" y="440" width="320" height="30" as="geometry" /></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9E9E9E;exitX=0.5;exitY=1;entryX=0.47;entryY=0;" edge="1" parent="1" source="v19" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9E9E9E;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="v18" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9E9E9E;exitX=0.3;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="v21" target="v35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="385" /><mxPoint x="1398" y="385" /></Array></mxGeometry></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9E9E9E;" edge="1" parent="1" source="v35" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9E9E9E;" edge="1" parent="1" source="v35" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9E9E9E;" edge="1" parent="1" source="v35" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v23" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="v23" target="v27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="608" /><mxPoint x="1330" y="608" /></Array></mxGeometry></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="v25" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v45" value="espera auth-lambda e os cinco serviços" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1590" y="640" width="280" height="30" as="geometry" /></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D86613;" edge="1" parent="1" source="v22" target="v45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D86613;" edge="1" parent="1" source="v25" target="v45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D86613;" edge="1" parent="1" source="v27" target="v45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D86613;exitX=0.5;exitY=1;entryX=0.15;entryY=1;" edge="1" parent="1" source="v26" target="v45"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="720" /><mxPoint x="1632" y="720" /></Array></mxGeometry></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D86613;" edge="1" parent="1" source="v45" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v51" value="Laranja: o Gateway espera todos os serviços porque descobre o NLB de cada um (as setas de core e execution até essa espera foram omitidas). O notification espera o core, e o billing espera o core e o stock, porque o CD descobre o NLB dessas dependências para as chamadas síncronas. O &lt;i&gt;down.yml&lt;/i&gt; destrói tudo no caminho inverso." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="920" y="760" width="680" height="80" as="geometry" /></mxCell><mxCell id="v52" value="CD de cada microsserviço (cd.yml: workflow_call pelo up.yml ou workflow_dispatch manual)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1850" height="220" as="geometry" /></mxCell><mxCell id="v53" value="Credenciais AWS&lt;br&gt;(secrets do repositório)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="50" y="970" width="170" height="60" as="geometry" /></mxCell><mxCell id="v54" value="Endereço do RDS&lt;br&gt;do serviço" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="246" y="970" width="170" height="60" as="geometry" /></mxCell><mxCell id="e55" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="v53" target="v54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v56" value="kubeconfig do cluster&lt;br&gt;ms-ofisy-&amp;lt;service&amp;gt;-cluster" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="442" y="970" width="170" height="60" as="geometry" /></mxCell><mxCell id="e57" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;" edge="1" parent