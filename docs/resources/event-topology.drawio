<mxfile host="app.diagrams.net" agent="Claude"><diagram id="event-topology" name="Mapa de eventos"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1129.5" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Mapa de eventos: tópicos SNS FIFO → filas SQS FIFO" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry" /></mxCell><mxCell id="v2" value="Cada coluna é o tópico de um produtor; cada linha é a fila de um consumidor. A célula mostra o filtro da assinatura (campo &lt;i&gt;type&lt;/i&gt; do envelope) e, em itálico, o que o consumidor faz. Fonte: &lt;i&gt;techchallenge-ofisy-eks-infra/messaging/main.tf&lt;/i&gt;, conferido com os handlers de cada serviço e os scripts do LocalStack." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1560" height="44" as="geometry" /></mxCell><mxCell id="v3" value="produtor →&lt;br&gt;tópico" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="360" height="120" as="geometry" /></mxCell><mxCell id="v4" value="consumidor ↓ fila" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="360" height="24" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;core&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;techchallenge-ofisy&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="240" height="44" as="geometry" /></mxCell><mxCell id="v6" value="SNS FIFO&lt;br&gt;&lt;b&gt;ofisy-service-order-events.fifo&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="192" width="260" height="44" as="geometry" /></mxCell><mxCell id="e7" value="outbox" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v8" value="&lt;b&gt;ms-ofisy-billing&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="120" width="240" height="44" as="geometry" /></mxCell><mxCell id="v9" value="SNS FIFO&lt;br&gt;&lt;b&gt;ofisy-billing-events.fifo&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="192" width="260" height="44" as="geometry" /></mxCell><mxCell id="e10" value="outbox" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v11" value="&lt;b&gt;ms-ofisy-stock&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="120" width="240" height="44" as="geometry" /></mxCell><mxCell id="v12" value="SNS FIFO&lt;br&gt;&lt;b&gt;ofisy-stock-events.fifo&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="192" width="260" height="44" as="geometry" /></mxCell><mxCell id="e13" value="outbox" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v14" value="&lt;b&gt;ms-ofisy-execution&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="120" width="240" height="44" as="geometry" /></mxCell><mxCell id="v15" value="SNS FIFO&lt;br&gt;&lt;b&gt;ofisy-execution-events.fifo&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="192" width="260" height="44" as="geometry" /></mxCell><mxCell id="e16" value="outbox" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v17" value="&lt;b&gt;core&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mantém o status da OS&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="327.0" width="150" height="52" as="geometry" /></mxCell><mxCell id="v18" value="SQS FIFO&lt;br&gt;&lt;b&gt;ofisy-service-order.fifo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DLQ ofisy-service-order-dlq.fifo&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="323.0" width="190" height="60" as="geometry" /></mxCell><mxCell id="e19" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;" edge="1" parent="1" source="v18"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="353.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v20" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="426" y="280" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v21" value="&lt;b&gt;QuoteSentForApproval&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;OS → AWAITING_APPROVAL&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;QuoteApproved&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;OS → AWAITING_EXECUTION&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;QuoteCancelled&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;OS → CANCELLED&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PaymentConfirmed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;OS → PAID (libera a entrega)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="726" y="280" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v22" value="&lt;b&gt;StockRefunded&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;OS → CANCELLED (reprovação)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1026" y="280" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v23" value="&lt;b&gt;ExecutionStarted&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;OS → IN_PROGRESS&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AllExecutionsCompleted&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;OS → FINISHED → ServiceOrderFinished&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1326" y="280" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v24" value="&lt;b&gt;ms-ofisy-billing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;orçamento e cobrança&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="463.75" width="150" height="52" as="geometry" /></mxCell><mxCell id="v25" value="SQS FIFO&lt;br&gt;&lt;b&gt;ofisy-billing.fifo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DLQ ofisy-billing-dlq.fifo&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="459.75" width="190" height="60" as="geometry" /></mxCell><mxCell id="e26" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;" edge="1" parent="1" source="v25"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="489.75" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v27" value="&lt;b&gt;ServiceOrderFinished&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;cria a order no Mercado Pago, cobrança PENDING → PaymentCheckoutCreated&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="426" y="426.0" width="288" height="119.5" as="geometry" /></mxCell><mxCell id="v28" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="726" y="426.0" width="288" height="119.5" as="geometry" /></mxCell><mxCell id="v29" value="&lt;b&gt;StockConsumed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;orçamento → AWAITING_APPROVAL → QuoteSentForApproval&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;StockConsumptionFailed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;orçamento → CANCELLED → QuoteCancelled&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;StockRefunded&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;orçamento aberto → CANCELLED → QuoteCancelled&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1026" y="426.0" width="288" height="119.5" as="geometry" /></mxCell><mxCell id="v30" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1326" y="426.0" width="288" height="119.5" as="geometry" /></mxCell><mxCell id="v31" value="&lt;b&gt;ms-ofisy-stock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;baixa e devolução de peças&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="597.5" width="150" height="52" as="geometry" /></mxCell><mxCell id="v32" value="SQS FIFO&lt;br&gt;&lt;b&gt;ofisy-stock.fifo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DLQ ofisy-stock-dlq.fifo&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="593.5" width="190" height="60" as="geometry" /></mxCell><mxCell id="e33" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;" edge="1" parent="1" source="v32"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="623.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v34" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="426" y="553.5" width="288" height="132.0" as="geometry" /></mxCell><mxCell id="v35" value="&lt;b&gt;QuoteCreated&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;baixa as peças → StockConsumed ou StockConsumptionFailed&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;QuoteUpdated&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;ajusta a diferença → StockConsumed ou StockConsumptionFailed&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;QuoteReproved&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;devolve as peças → StockRefunded&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="726" y="553.5" width="288" height="132.0" as="geometry" /></mxCell><mxCell id="v36" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1026" y="553.5" width="288" height="132.0" as="geometry" /></mxCell><mxCell id="v37" value="&lt;b&gt;AllExecutionsCancelled&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;devolve as peças → StockRefunded&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1326" y="553.5" width="288" height="132.0" as="geometry" /></mxCell><mxCell id="v38" value="&lt;b&gt;ms-ofisy-execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;execuções dos serviços&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="722.5" width="150" height="52" as="geometry" /></mxCell><mxCell id="v39" value="SQS FIFO&lt;br&gt;&lt;b&gt;ofisy-execution.fifo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DLQ ofisy-execution-dlq.fifo&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="718.5" width="190" height="60" as="geometry" /></mxCell><mxCell id="e40" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;" edge="1" parent="1" source="v39"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="748.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v41" value="&lt;b&gt;ServiceOrderCancelled&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;cancela as execuções ativas → AllExecutionsCancelled&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="426" y="693.5" width="288" height="102" as="geometry" /></mxCell><mxCell id="v42" value="&lt;b&gt;QuoteApproved&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;cria uma execução PENDING por serviço&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="726" y="693.5" width="288" height="102" as="geometry" /></mxCell><mxCell id="v43" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1026" y="693.5" width="288" height="102" as="geometry" /></mxCell><mxCell id="v44" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1326" y="693.5" width="288" height="102" as="geometry" /></mxCell><mxCell id="v45" value="&lt;b&gt;ms-ofisy-notification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;avisos (DynamoDB)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="850.5" width="150" height="52" as="geometry" /></mxCell><mxCell id="v46" value="SQS FIFO&lt;br&gt;&lt;b&gt;ofisy-notification.fifo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DLQ ofisy-notification-dlq.fifo&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="846.5" width="190" height="60" as="geometry" /></mxCell><mxCell id="e47" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;" edge="1" parent="1" source="v46"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="876.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v48" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="426" y="803.5" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v49" value="&lt;b&gt;QuoteSentForApproval&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;aviso de orçamento (busca o cliente no core)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PaymentCheckoutCreated&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;aviso com o link de pagamento&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PaymentConfirmed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;aviso de pagamento confirmado&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PaymentFailed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;aviso de pagamento recusado ou expirado&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="726" y="803.5" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v50" value="&lt;b&gt;StockLow&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;aviso de estoque baixo para a equipe&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1026" y="803.5" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v51" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1326" y="803.5" width="288" height="138.0" as="geometry" /></mxCell><mxCell id="v52" value="&lt;b&gt;Contrato comum a todos os eventos&lt;/b&gt;&lt;br&gt;Envelope JSON: &lt;i&gt;eventId&lt;/i&gt; (idempotência), &lt;i&gt;type&lt;/i&gt; (filtro e despacho), &lt;i&gt;serviceOrderId&lt;/i&gt;, &lt;i&gt;occurredAt&lt;/i&gt;, &lt;i&gt;payload&lt;/i&gt;.&lt;br&gt;Publicação pelo outbox transacional (tabela &lt;i&gt;outbox_events&lt;/i&gt;, publicador a cada 1 s, lote de 100), com o contexto do trace no atributo &lt;i&gt;_datadog&lt;/i&gt;.&lt;br&gt;FIFO por OS: &lt;i&gt;MessageGroupId&lt;/i&gt; = serviceOrderId (o StockLow usa o id do item). Tópicos com deduplicação por conteúdo.&lt;br&gt;Assinaturas com &lt;i&gt;RawMessageDelivery&lt;/i&gt; e &lt;i&gt;FilterPolicy&lt;/i&gt; no corpo (&lt;i&gt;FilterPolicyScope=MessageBody&lt;/i&gt;). Cada fila tem DLQ com &lt;i&gt;maxReceiveCount&lt;/i&gt; = 5.&lt;br&gt;Consumo idempotente: tabela &lt;i&gt;processed_events&lt;/i&gt; nos serviços com PostgreSQL; no notification, inserção condicional no DynamoDB.&lt;br&gt;O ms-ofisy-notification não publica eventos." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="969.5" width="820" height="128" as="geometry" /></mxCell><mxCell id="v53" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="977.5" width="30" height="18" as="geometry" /></mxCell><mxCell id="v54" value="Microsserviço (produtor ou consumidor)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="940" y="975.5" width="300" height="22" as="geometry" /></mxCell><mxCell id="v55" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="1007.5" width="30" height="18" as="geometry" /></mxCell><mxCell id="v56" value="Tópico SNS FIFO / fila SQS FIFO" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="940" y="1005.5" width="300" height="22" as="geometry" /></mxCell><mxCell id="v57" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="900" y="1037.5" width="30" height="18" as="geometry" /></mxCell><mxCell id="v58" value="Assinatura: eventos do filtro e efeito no consumidor" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="940" y="1035.5" width="340" height="22" as="geometry" /></mxCell><mxCell id="v59" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#DDDDDD;fontSize=10;fontColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="900" y="1067.5" width="30" height="18" as="geometry" /></mxCell><mxCell id="v60" value="Sem assinatura entre o tópico e a fila" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="940" y="1065.5" width="300" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
