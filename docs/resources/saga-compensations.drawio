<mxfile host="app.diagrams.net" agent="Claude"><diagram id="saga-comp" name="Saga da OS - compensações"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1790" pageHeight="3032" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Saga da Ordem de Serviço: compensações e caminhos alternativos" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1710" height="34" as="geometry" /></mxCell><mxCell id="v2" value="Cada serviço desfaz só a própria parte ao receber um evento de reprovação, falha ou cancelamento, e todo consumo é idempotente (processed_events por eventId). Chips vermelhos são compensações; chips cinza são eventos que chegam depois e só são registrados, porque o status já está à frente." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1710" height="44" as="geometry" /></mxCell><mxCell id="v3" value="Cliente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="110" width="30" height="50" as="geometry" /></mxCell><mxCell id="v4" value="Funcionário" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="110" width="30" height="50" as="geometry" /></mxCell><mxCell id="v5" value="core&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;techchallenge-ofisy&lt;br&gt;OS, clientes, veículos, catálogo&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="170" height="56" as="geometry" /></mxCell><mxCell id="v6" value="ms-ofisy-billing&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;orçamento e cobrança&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="170" height="56" as="geometry" /></mxCell><mxCell id="v7" value="ms-ofisy-stock&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;peças e movimentações&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="110" width="170" height="56" as="geometry" /></mxCell><mxCell id="v8" value="ms-ofisy-execution&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;execução dos serviços&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="170" height="56" as="geometry" /></mxCell><mxCell id="v9" value="ms-ofisy-notification&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;avisos (DynamoDB)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="110" width="170" height="56" as="geometry" /></mxCell><mxCell id="v10" value="Mercado Pago&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;Checkout Pro (Orders API)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#B0B0B0;strokeColor=#8C8C8C;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="110" width="170" height="56" 