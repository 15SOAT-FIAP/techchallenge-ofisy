=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="720" y="890" width="170" height="26" as="geometry" /></mxCell><mxCell id="e26" value="&lt;b&gt;StockRefunded&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-stock-events → ofisy-service-order.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="1015" y="960" as="sourcePoint" /><mxPoint x="595" y="960" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v27" value="já CANCELLED: só registra" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="510" y="982" width="170" height="26" as="geometry" /></mxCell><mxCell id="v28" value="O core não ouve o &lt;i&gt;QuoteReproved&lt;/i&gt;: a OS é cancelada pelo &lt;i&gt;StockRefunded&lt;/i&gt;, depois que as peças voltaram.&lt;br&gt;A volta extra (&lt;i&gt;ServiceOrderCancelled&lt;/i&gt; → &lt;i&gt;AllExecutionsCancelled&lt;/i&gt; → &lt;i&gt;StockRefunded&lt;/i&gt;) é prevista no ADR-0012 e termina sozinha." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="605" y="1020" width="620" height="44" as="geometry" /></mxCell><mxCell id="v29" value="BLOCO 2 · Falta de peça no estoque (na criação ou na edição do orçamento)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontStyle=1;fontSize=12;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="1086" width="1730" height="30" as="geometry" /></mxCell><mxCell id="e30" value="&lt;b&gt;QuoteCreated / QuoteUpdated&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-billing-events → ofisy-stock.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="805" y="1170" as="sourcePoint" /><mxPoint x="1015" y="1170" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v31" value="saldo insuficiente:&lt;br&gt;não baixa nada" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="930" y="1192" width="170" height="38" as="geometry" /></mxCell><mxCell id="e32" value="&lt;b&gt;StockConsumptionFailed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-stock-events → ofisy-billing.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="1015" y="1274" as="sourcePoint" /><mxPoint x="805" y="1274" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v33" value="Orçamento &lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;(motivo STOCK_UNAVAILABLE)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="1296" width="170" height="38" as="geometry" /></mxCell><mxCell id="e34" value="&lt;b&gt;QuoteCancelled&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-billing-events → ofisy-service-order.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxP