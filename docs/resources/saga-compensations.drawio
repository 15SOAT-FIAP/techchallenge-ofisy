></mxCell><mxCell id="e16" value="&lt;b&gt;StockRefunded&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-stock-events → ofisy-service-order.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="1015" y="476" as="sourcePoint" /><mxPoint x="595" y="476" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v17" value="OS &lt;b&gt;CANCELLED&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="510" y="498" width="170" height="26" as="geometry" /></mxCell><mxCell id="e18" value="&lt;b&gt;StockRefunded&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-stock-events → ofisy-billing.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="1015" y="568" as="sourcePoint" /><mxPoint x="805" y="568" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v19" value="já REPROVED: só registra" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="170" height="26" as="geometry" /></mxCell><mxCell id="v20" value="O core não ouve o &lt;i&gt;QuoteReproved&lt;/i&gt;: a OS é cancelada pelo &lt;i&gt;StockRefunded&lt;/i&gt;, depois que as peças voltaram.&lt;br&gt;Como a OS ainda não tem execuções, esse cancelamento não publica o &lt;i&gt;ServiceOrderCancelled&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="605" y="628" width="600" height="44" as="geometry" /></mxCell><mxCell id="v21" value="BLOCO 2 · Falta de peça no estoque (na criação ou na edição do orçamento)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontStyle=1;fontSize=12;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="694" width="1730" height="30" as="geometry" /></mxCell><mxCell id="e22" value="&lt;b&gt;QuoteCreated / QuoteUpdated&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-billing-events → ofisy-stock.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="805" y="778" as="sourcePoint" /><mxPoint x="1015" y="778" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v23" value="saldo insuficiente:&lt;br&gt;nada se move" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="930" y="800" width="170" height="38" as="geometry" /></mxCell><mxCell id="e24" value="&lt;b&gt;StockConsumptionFailed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-stock-events → ofisy-billing.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="1015" y="882" as="sourcePoint" /><mxPoint x="805" y="882" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v25" value="Orçamento &lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;(motivo STOCK_UNAVAILABLE)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="904" width="170" height="38" as="geometry" /></mxCell><mxCell id="e26" value="&lt;b&gt;QuoteCancelled&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-billing-events → ofisy-service-order.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="805" y="986" as="sourcePoint" /><mxPoint x="595" y="986" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v27" value="OS &lt;b&gt;CANCELLED&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="510" y="1008" width="170" height="26" as="geometry" /></mxCell><mxCell id="v28" value="Na criação, nada tinha saído do estoque. Na edição, o que saiu na criação continua com a OS:&lt;br&gt;o cancelamento pelo orçamento não publica o &lt;i&gt;ServiceOrderCancelled&lt;/i&gt;, então não há &lt;i&gt;AllExecutionsCancelled&lt;/i&gt; para devolver." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="455" y="1046" width="560" height="44" as="geometry" /></mxCell><mxCell id="v29" value="BLOCO 3 · Atendente edita o orçamento antes da aprovação" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontStyle=1;fontSize=12;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="1112" width="1730" height="30" as="geometry" /></mxCell><mxCell id="e30" value="PATCH /api/v1/quotes/{id} { stockItems[], serviceItems[] } (só em AWAITING_APPROVAL)" style="html=1;endArrow=block;endFill=1;dashed=0;strokeColor=#1A1A1A;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="385" y="1184" as="sourcePoint" /><mxPoint x="805" y="1184" as="targetPoint" /><mxPoint x="0" y="-11" as="offset" /></mxGeometry></mxCell><mxCell id="v31" value="Orçamento volta a &lt;b&gt;PENDING&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="1206" width="170" height="26" as="geometry" /></mxCell><mxCell id="e32" value="&lt;b&gt;QuoteUpdated&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-billing-events → ofisy-stock.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="805" y="1276" as="sourcePoint" /><mxPoint x="1015" y="1276" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v33" value="baixa o que aumentou e&lt;br&gt;devolve o que diminuiu" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="930" y="1298" width="170" height="38" as="geometry" /></mxCell><mxCell id="e34" value="&lt;b&gt;StockConsumed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-stock-events → ofisy-billing.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="1015" y="1380" as="sourcePoint" /><mxPoint x="805" y="1380" as="targetPoint" /><mxPoint x="0" y="-17" a