ometry" /></mxCell><mxCell id="v40" value="Se faltar peça na edição, o fluxo segue o BLOCO 2." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1025" y="1648" width="300" height="31" as="geometry" /></mxCell><mxCell id="v41" value="BLOCO 4 · Atendente cancela a OS (até IN_PROGRESS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontStyle=1;fontSize=12;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="1701" width="1730" height="30" as="geometry" /></mxCell><mxCell id="e42" value="PATCH /api/v1/service-orders/{id}/cancel" style="html=1;endArrow=block;endFill=1;dashed=0;strokeColor=#1A1A1A;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="385" y="1773" as="sourcePoint" /><mxPoint x="595" y="1773" as="targetPoint" /><mxPoint x="0" y="-11" as="offset" /></mxGeometry></mxCell><mxCell id="v43" value="OS &lt;b&gt;CANCELLED&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="510" y="1795" width="170" height="26" as="geometry" /></mxCell><mxCell id="e44" value="&lt;b&gt;ServiceOrderCancelled&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ofisy-service-order-events → ofisy-execution.fifo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;dashed=0;strokeColor=#D86613;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="595" y="1865" as="sourcePoint" /><mxPoint x="1225" y="1865" as="targetPoint" /><mxPoint x="0" y="-17" as="offset" /></mxGeometry></mxCell><mxCell id="v45" value="execuções PENDING e IN_PROGRESS&lt;