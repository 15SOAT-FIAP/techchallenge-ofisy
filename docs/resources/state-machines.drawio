<mxfile host="app.diagrams.net" agent="Claude"><diagram id="state-machines" name="Máquinas de estado"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Máquinas de estado da saga: o que move cada status" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="34" as="geometry" /></mxCell><mxCell id="v2" value="Setas laranja são transições disparadas por evento; setas pretas, por chamada HTTP. O que vem depois de ⇒ é o evento publicado na mesma transação (outbox). Os status estão como no código (enums de cada serviço)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1900" height="30" as="geometry" /></mxCell><mxCell id="v3" value="Ordem de Serviço · core (ServiceOrderStatus)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="2030" height="330" as="geometry" /></mxCell><mxCell id="v4" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="222.0" width="20" height="20" as="geometry" /></mxCell><mxCell id="v5" value="RECEIVED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="110" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="v6" value="IN_DIAGNOSTIC" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="355" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="v7" value="AWAITING_APPROVAL" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="v8" value="AWAITING_EXECUTION" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="845" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="v9" value="IN_PROGRESS" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1090" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="v10" value="FINISHED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1335" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="v11" value="PAID" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1580" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="v12" value="DELIVERED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1825" y="210" width="150" height="44" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="PATCH /{id}/start-diagnostic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="e15" value="&lt;b&gt;QuoteSentForApproval&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="e16" value="&lt;b&gt;QuoteApproved&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="e17" value="&lt;b&gt;ExecutionStarted&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="e18" value="&lt;b&gt;AllExecutionsCompleted&lt;/b&gt;&lt;br&gt;⇒ ServiceOrderFinished" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell><mxCell id="e19" value="&lt;b&gt;PaymentConfirmed&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="e20" value="PATCH /{id}/deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="v21" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="96" y="176" width="1158" height="104" as="geometry" /></mxCell><mxCell id="v22" value="CANCELLED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="600" y="385" width="150" height="44" as="geometry" /></mxCell><mxCell id="e23" value="qualquer status de RECEIVED a IN_PROGRESS:&lt;br&gt;PATCH /{id}/cancel · &lt;b&gt;QuoteCancelled&lt;/b&gt; · &lt;b&gt;StockRefunded&lt;/b&gt;&lt;br&gt;⇒ ServiceOrderCancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" target="v22"><mxGeometry relative="1" as="geometry"><mxPoint x="675.0" y="280" as="sourcePoint" /></mxGeometry></mxCell><mxCell id="v24" value="Se o &lt;i&gt;AllExecutionsCompleted&lt;/i&gt; chega com a OS ainda em AWAITING_EXECUTION (o &lt;i&gt;ExecutionStarted&lt;/i&gt; se perdeu), o core aplica as duas transições.&lt;br&gt;Eventos que chegam com a OS já à frente só são registrados em &lt;i&gt;processed_events&lt;/i&gt;; eventos atrás do status voltam para a fila e, depois de 5 tentativas, vão para a DLQ." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1030" y="360" width="1000" height="50" as="geometry" /></mxCell><mxCell id="v25" value="Orçamento · ms-ofisy-billing (QuoteStatus)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="1250" height="380" as="geometry" /></mxCell><mxCell id="v26" value="PENDING" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="260" y="570" width="170" height="44" as="geometry" /></mxCell><mxCell id="v27" value="AWAITING_APPROVAL" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="620" y="570" width="170" height="44" as="geometry" /></mxCell><mxCell id="v28" value="APPROVED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="170" height="44" as="geometry" /></mxCell><mxCell id="v29" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="80" y="582.0" width="20" height="20" as="geometry" /></mxCell><mxCell id="e30" value="POST /quotes&lt;br&gt;com peças ⇒ QuoteCreated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v29" target="v26"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-20" as="offset" /></mxGeometry></mxCell><mxCell id="e31" value="POST /quotes só com serviços ⇒ QuoteSentForApproval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v29" target="v27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="520" /><mxPoint x="705" y="520" /></Array></mxGeometry></mxCell><mxCell id="e32" value="&lt;b&gt;StockConsumed&lt;/b&gt;&lt;br&gt;⇒ QuoteSentForApproval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="v26" target="v27"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell><mxCell id="e33" value="PATCH /quotes/{id} (edição)&lt;br&gt;⇒ QuoteUpdated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="v27" target="v26"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="22" as="offset" /></mxGeometry></mxCell><mxCell id="e34" value="PATCH /{id}/approve&lt;br&gt;⇒ QuoteApproved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v27" target="v28"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell><mxCell id="v35" value="REPROVED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="620" y="740" width="170" height="44" as="geometry" /></mxCell><mxCell id="e36" value="PATCH /{id}/reprove&lt;br&gt;⇒ QuoteReproved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v27" target="v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v37" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="544" width="950" height="96" as="geometry" /></mxCell><mxCell id="v38" value="CANCELLED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1000" y="740" width="170" height="44" as="geometry" /></mxCell><mxCell id="e39" value="&lt;b&gt;StockConsumptionFailed&lt;/b&gt; (motivo STOCK_UNAVAILABLE)&lt;br&gt;&lt;b&gt;StockRefunded&lt;/b&gt; (motivo SERVICE_ORDER_CANCELLED)&lt;br&gt;⇒ QuoteCancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" target="v38"><mxGeometry relative="1" as="geometry"><mxPoint x="1085" y="640" as="sourcePoint" /></mxGeometry></mxCell><mxCell id="v40" value="Um orçamento por OS. Só é editado, aprovado ou reprovado em AWAITING_APPROVAL. O &lt;i&gt;StockRefunded&lt;/i&gt; só cancela orçamento ainda aberto (PENDING, AWAITING_APPROVAL ou APPROVED)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="520" height="46" as="geometry" /></mxCell><mxCell id="v41" value="Execução · ms-ofisy-execution (ServiceOrderExecutionStatus)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1300" y="450" width="760" height="380" as="geometry" /></mxCell><mxCell id="v42" value="PENDING" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1380" y="570" width="130" height="44" as="geometry" /></mxCell><mxCell id="v43" value="IN_PROGRESS" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1620" y="570" width="130" height="44" as="geometry" /></mxCell><mxCell id="v44" value="COMPLETED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1860" y="570" width="130" height="44" as="geometry" /></mxCell><mxCell id="v45" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1320" y="582.0" width="20" height="20" as="geometry" /></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v45" target="v42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v47" value="&lt;b&gt;QuoteApproved&lt;/b&gt;: uma por serviço" style="text;html=1;fontSize=9;align=left;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1312" y="530" width="200" height="20" as="geometry" /></mxCell><mxCell id="e48" value="PATCH /{id}/start&lt;br&gt;⇒ ExecutionStarted (1ª da OS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v42" target="v43"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell><mxCell id="e49" value="PATCH /{id}/complete&lt;br&gt;⇒ AllExecutionsCompleted (última)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v43" target="v44"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell><mxCell id="v50" value="CANCELLED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1500" y="740" width="130" height="44" as="geometry" /></mxCell><mxCell id="e51" value="de PENDING ou IN_PROGRESS: &lt;b&gt;ServiceOrderCancelled&lt;/b&gt;&lt;br&gt;⇒ AllExecutionsCancelled&lt;br&gt;(não sai se a OS já estava concluída)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" target="v50"><mxGeometry relative="1" as="geometry"><mxPoint x="1565" y="592.0" as="sourcePoint" /></mxGeometry></mxCell><mxCell id="v52" value="Cobrança · ms-ofisy-billing (PaymentStatus)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="850" width="2030" height="330" as="geometry" /></mxCell><mxCell id="v53" value="PENDING" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="420" y="960" width="150" height="44" as="geometry" /></mxCell><mxCell id="v54" value="PAID" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="150" height="44" as="geometry" /></mxCell><mxCell id="v55" value="FAILED" style="rounded=1