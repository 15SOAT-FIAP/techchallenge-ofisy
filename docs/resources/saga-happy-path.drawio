<mxfile host="app.diagrams.net" agent="Claude"><diagram id="saga-happy" name="Saga da OS - caminho feliz"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="3782" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Saga da Ordem de Serviço: caminho feliz (coreografia)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1920" height="34" as="geometry" /></mxCell><mxCell id="v2" value="Cada serviço publica fatos do próprio contexto pelo outbox (tópico SNS FIFO do produtor) e reage aos eventos que chegam na sua fila SQS FIFO, filtrados por &lt;i&gt;type&lt;/i&gt;. Setas laranja são eventos (tópico → fila); setas pretas são chamadas HTTP. Os chips mostram o status que cada serviço grava." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1920" height="44" as="geometry" /></mxCell><mxCell id="v3" value="Cliente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="110" width="30" height="50" as="geometry" /></mxCell><mxCell id="v4" value="Funcionário" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="110" width="30" height="50" as="geometry" /></mxCell><mxCell id="v5" value="API Gateway&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;Lambdas Ofisy Auth&lt;br&gt;e Authorizer&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#444444;fontColor=#ffffff;fontSize=1