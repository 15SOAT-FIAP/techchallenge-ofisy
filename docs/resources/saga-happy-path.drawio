 id="e15" value="JWT com a role (ADMIN, ATTENDANT, MECHANIC, STOCKMAN)" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#555555;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="805" y="376" as="sourcePoint" /><mxPoint x="595" y="376" as="targetPoint" /><mxPoint x="0" y="-11" as="offset" /></mxGeometry></mxCell><mxCell id="e16" value="JWT" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#555555;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="595" y="418" as="sourcePoint" /><mxPoint x="385" y="418" as="targetPoint" /><mxPoint x="0" y="-11" as="offset" /></mxGeometry></mxCell><mxCell id="v17" value="As chamadas seguintes do funcionário também passam pelo API Gateway, com &lt;i&gt;Bearer&lt;/i&gt; JWT.&lt;br&gt;Cada serviço valida o token com o mesmo segredo (o desenho omite o Gateway nessas setas)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="605" y="440" width="560" height="44" as="geometry" /></mxCell><mxCell id="v18" value="BLOCO B · Abertura e diagnóstico da OS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontStyle=1;fontSize=12;fontColor=#333333;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="506" width="1940" height="30" as="geometry" /></mxCell><mxCell id="e19" value="POST /api/v1/service-orders&lt;br&gt;{ vehicleId, customerId, report }" style="html=1;endArrow=block;endFill=1;dashed=0;strokeColor=#1A1A1A;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#1A1A1A;" edge="1" parent="1"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="385" y="590" as="sourcePoint" /><mxPoint x="805" y="590"