an]&lt;/i&gt;&lt;br&gt;Implementam as interfaces do domínio, incluindo outbox_events e processed_events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="925" width="360" height="100" as="geometry" /></mxCell><mxCell id="v26" value="&lt;b&gt;Spring Data JPA repositories&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring Data]&lt;/i&gt;&lt;br&gt;Persistência ORM sobre o banco" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="925" width="360" height="100" as="geometry" /></mxCell><mxCell id="v27" value="&lt;b&gt;Flyway&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;[Component]&lt;/i&gt; migrations (schema e seeds), aplicadas no start" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="1050" width="360" height="60" as="geometry" /></mxCell><mxCell id="v28" value="Transversal" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="930" y="880" width="500" height="260" as="geometry" /></mxCell><mxCell id="v29" value="&lt;b&gt;Presenters&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring Bean]&lt;/i&gt;&lt;br&gt;Convertem entidades em DTOs de resposta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="925" width="220" height="90" as="geometry" /></mxCell><mxCell id="v30" value="&lt;b&gt;GlobalExceptionHandler&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: ControllerAdvice]&lt;/i&gt;&lt;br&gt;Traduz exceções em status HTTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fo