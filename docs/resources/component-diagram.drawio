<mxfile host="app.diagrams.net" agent="Claude"><diagram id="core-components" name="Componentes"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="&lt;b&gt;Swagger UI&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Software System]&lt;/i&gt;&lt;br&gt;Documentação e testes manuais das rotas" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B0B0B0;strokeColor=#B0B0B0;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="200" height="70" as="geometry" /></mxCell><mxCell id="v2" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Software System]&lt;/i&gt;&lt;br&gt;Rotas de funcionário (JWT do core) e do cliente (Lambda Authorizer)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B0B0B0;strokeColor=#B0B0B0;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="10" width="240" height="70" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;ms-ofisy-billing e ms-ofisy-notification&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Software System]&lt;/i&gt;&lt;br&gt;Leituras síncronas com token de serviço" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B0B0B0;strokeColor=#B0B0B0;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="10" width="260" height="70" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;Fila ofisy-service-order.fifo&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Amazon SQS FIFO]&lt;/i&gt;&lt;br&gt;Eventos do billing, do stock e do execution, filtrados por type" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="10" width="300" height="70" as="geometry" /></mxCell><mxCell id="v5" value="Backend&amp;nbsp;&amp;nbsp;[Container: Spring Boot / Java 21]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;verticalAlign=top;align=right;spacingRight=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="10" y="140" width="1440" height="1120" as="geometry" /></mxCell><mxCell id="v6" value="Interface Adapters: Controllers [REST]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="560" height="200" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;Business Controllers&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring MVC]&lt;/i&gt;&lt;br&gt;Customer, Vehicle, ServiceCatalog, ServiceOrder e User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="225" width="190" height="120" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;LoginController&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring MVC]&lt;/i&gt;&lt;br&gt;POST /api/v1/login: autentica e emite o JWT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="235" width="180" height="110" as="geometry" /></mxCell><mxCell id="v9" value="Interface Adapters: Mensageria [SNS/SQS]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="620" y="180" width="810" height="200" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;ServiceOrderEventsListener&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: @SqsListener]&lt;/i&gt;&lt;br&gt;Lê o envelope, extrai o trace e despacha pelo &lt;i&gt;type&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="225" width="200" height="120" as="geometry" /></mxCell><mxCell id="v11" value="&lt;b&gt;Event Handlers&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring Bean]&lt;/i&gt;&lt;br&gt;QuoteSentForApproval, QuoteApproved, QuoteCancelled, StockRefunded, ExecutionStarted, AllExecutionsCompleted, PaymentConfirmed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="225" width="250" height="120" as="geometry" /></mxCell><mxCell id="v12" value="&lt;b&gt;OutboxEventPublisher&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: @Scheduled]&lt;/i&gt;&lt;br&gt;A cada 1 s lê os eventos pendentes do outbox, publica no SNS com o trace no atributo _datadog e marca como publicados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="225" width="260" height="120" as="geometry" /></mxCell><mxCell id="v13" value="Application: UseCases (orquestração)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="870" height="230" as="geometry" /></mxCell><mxCell id="v14" value="&lt;b&gt;Business UseCases&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring Bean]&lt;/i&gt;&lt;br&gt;Um caso de uso por operação (register, create, start-diagnostic, cancel, deliver...). O cancel grava o ServiceOrderCancelled no outbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="250" height="130" as="geometry" /></mxCell><mxCell id="v15" value="&lt;b&gt;UseCases da saga&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring Bean]&lt;/i&gt;&lt;br&gt;awaitapproval, approve, cancelbyquote, startexecution, finish, confirmpayment. Idempotentes por processed_events; gravam o evento seguinte no outbox na mesma transação" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="300" height="130" as="geometry" /></mxCell><mxCell id="v16" value="&lt;b&gt;Login use case&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring Bean]&lt;/i&gt;&lt;br&gt;Valida credenciais e solicita a geração do token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="480" width="220" height="110" as="geometry" /></mxCell><mxCell id="v17" value="Segurança" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="930" y="420" width="500" height="420" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;JwtAuthFilter&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Spring Security Filter]&lt;/i&gt;&lt;br&gt;Valida o JWT de funcionário e o token de serviço e popula o SecurityContext" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="690" width="220" height="110" as="geometry" /></mxCell><mxCell id="v19" value="&lt;b&gt;SecurityConfig&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Configuration]&lt;/i&gt;&lt;br&gt;Cadeia de filtros, rotas públicas, AccessDeniedHandler e AuthenticationEntryPoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#707070;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="465" width="220" height="110" as="geometry" /></mxCell><mxCell id="v20" value="&lt;b&gt;OfisyUserDetailsService&lt;/b&gt;&lt;br&